---
interface Props {
  n: number | string;
  caption?: string;
  meta?: string;
  href?: string;
  /** Short label that sits under "Fig. N" in the margin (e.g. "CRYSTALLINE", "2024"). Optional. */
  kicker?: string;
}

const { n, caption, meta, href, kicker } = Astro.props;
---
<figure class="figure">
  <div class="figure__num">
    <span class="mono">Fig.&nbsp;{n}</span>
    {kicker && <small class="mono">{kicker}</small>}
  </div>

  <div class="figure__main">
    <div class="figure__frame">
      {href
        ? <a href={href} rel="noopener" class="figure__link"><slot /></a>
        : <slot />}
    </div>

    {(caption || Astro.slots.has('caption') || meta) && (
      <figcaption class="figure__caption mono">
        {Astro.slots.has('caption')
          ? <slot name="caption" />
          : caption}
        {meta && <span class="figure__meta"> · {meta}</span>}
      </figcaption>
    )}

    {Astro.slots.has('body') && (
      <div class="figure__body">
        <slot name="body" />
      </div>
    )}
  </div>
</figure>

<style>
  .figure {
    display: grid;
    grid-template-columns: var(--margin-col) 1fr;
    column-gap: var(--gutter);
    margin: 0;
  }

  .figure + .figure {
    margin-top: var(--space-16);
  }

  .figure__num {
    grid-column: 1;
    text-align: right;
    padding-top: 0.3rem;
    font-size: var(--fs-xs);
    color: var(--rust);
    font-variant-numeric: tabular-nums;
    letter-spacing: var(--tracking-mono);
  }

  .figure__num small {
    display: block;
    font-size: 11px;
    color: var(--ink-3);
    margin-top: 0.4rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .figure__main {
    grid-column: 2;
    min-width: 0;
  }

  .figure__frame {
    display: block;
    color: inherit;
    overflow: hidden;
  }

  .figure__link {
    display: block;
    color: inherit;
    text-decoration: none;
    transition: opacity 140ms linear;
  }
  .figure__link:hover { opacity: 0.85; }
  .figure__link:focus-visible {
    outline: 2px solid var(--turquoise);
    outline-offset: 3px;
  }

  .figure__caption {
    display: block;
    margin-top: var(--space-3);
    font-size: var(--fs-xs);
    color: var(--ink-2);
    line-height: 1.5;
  }
  .figure__meta { color: var(--ink-3); }

  .figure__body {
    margin-top: var(--space-4);
    max-width: var(--measure);
    color: var(--ink-2);
    font-size: var(--fs-base);
  }
  .figure__body :global(p + p) { margin-top: 0.7em; }

  /* Narrow viewports: collapse to single column, number stacks above the figure. */
  @media (max-width: 50rem) {
    .figure {
      grid-template-columns: 1fr;
    }
    .figure__num {
      text-align: left;
      padding-top: 0;
      padding-bottom: var(--space-2);
    }
    .figure__num small {
      display: inline;
      margin: 0 0 0 0.6rem;
    }
  }
</style>
