---
/*
 * Figure — work samples presented the way figures appear in a journal:
 * numbered, mono-captioned, with a short prose paragraph explaining what
 * it is and why it matters. Never a card, never shadowed.
 *
 * Slot layout:
 *   default slot → the visual (image, iframe, link, link-wrapped img…)
 *   "body" slot  → the prose paragraph(s)
 */

interface Props {
  n: number | string;
  caption?: string;
  meta?: string;   // e.g. "2024 · Blender · commissioned"
  href?: string;   // optional: makes the whole figure clickable
  /** When true, omit the leading § divider. Use on Fig. 1. */
  first?: boolean;
}

const { n, caption, meta, href, first } = Astro.props;
const WrapperTag = href ? "a" : "div";
const hasVisual = Astro.slots.has("default");
---
{!first && <div class="fig-divider" aria-hidden="true">§</div>}

<figure class="figure">
  <WrapperTag
    class:list={[
      "figure__frame",
      { "figure__frame--link": href, "figure__frame--placeholder": !hasVisual },
    ]}
    {...href ? { href, rel: "noopener" } : {}}
  >
    {hasVisual
      ? <slot />
      : <span class="figure__placeholder mono" aria-hidden="true">[ figure pending ]</span>
    }
  </WrapperTag>

  <figcaption class="figure__caption">
    <span class="figure__number">Fig. {n}</span>
    <span class="figure__sep" aria-hidden="true">—</span>
    <span class="figure__title">{Astro.slots.has("caption") ? <slot name="caption" /> : caption}</span>
    {meta && <span class="figure__meta"> · {meta}</span>}
  </figcaption>

  <div class="figure__body">
    <slot name="body" />
  </div>
</figure>

<style>
  .figure {
    display: block;
    margin: 0;
  }

  /* § ornament between figures — hairlines flank a single mono section symbol. */
  .fig-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: var(--space-16) 0;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.4em;
    color: var(--ink-3);
  }

  .fig-divider::before,
  .fig-divider::after {
    content: "";
    flex: 1;
    border-top: 1px solid var(--rule-faint);
    margin: 0 1.25rem;
  }

  .figure__frame {
    display: block;
    color: inherit;
    text-decoration: none;
    overflow: hidden;
  }

  .figure__frame--placeholder {
    min-height: 10rem;
    padding: var(--space-12) 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background:
      repeating-linear-gradient(
        45deg,
        transparent 0 14px,
        var(--rule-faint) 14px 15px
      );
  }

  .figure__placeholder {
    font-size: var(--fs-xs);
    color: var(--ink-3);
    background: var(--paper);
    padding: var(--space-1) var(--space-3);
    letter-spacing: var(--tracking-mono);
  }

  .figure__frame--link {
    transition: opacity 140ms linear;
  }

  .figure__frame--link:hover {
    opacity: 0.85;
  }

  .figure__frame--link:focus-visible {
    outline: 2px solid var(--turquoise);
    outline-offset: 3px;
  }

  .figure__caption {
    display: block;
    margin-top: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--ink-2);
    letter-spacing: var(--tracking-mono);
    line-height: 1.5;
    font-variant-numeric: tabular-nums;
  }

  .figure__number {
    color: var(--rust);
    font-weight: 500;
  }

  .figure__sep {
    margin: 0 0.4em;
    color: var(--ink-3);
  }

  .figure__title {
    color: var(--ink);
  }

  .figure__meta {
    color: var(--ink-3);
  }

  .figure__body {
    margin-top: var(--space-4);
    max-width: var(--measure);
    color: var(--ink-2);
    font-size: var(--fs-base);
  }

  .figure__body :global(p + p) {
    margin-top: 0.7em;
  }
</style>
